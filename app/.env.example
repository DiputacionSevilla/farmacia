# Copiar a .env (desarrollo) o definir como variables de entorno en el
# despliegue Docker. Nunca commitear .env con valores reales.

# Base de datos
DATABASE_URL="postgresql://farmacias:farmacias@localhost:5432/farmacias_guardia?schema=public"

# Sesión administrativa (JWT firmado, cookie httpOnly). Generar con:
#   openssl rand -base64 48
AUTH_SECRET="cambia-este-valor-en-produccion"

# Fuente oficial del calendario de guardias (§4.1). Configurable, nunca
# codificada directamente en el código.
DUTY_PDF_URL="https://servicios.farmaceuticosdesevilla.es/images/farmaciasguardia/T4/mairenadelalcor.pdf"
DUTY_PDF_ALLOWED_HOSTS="servicios.farmaceuticosdesevilla.es"

# Almacenamiento de objetos para los PDF originales (RF009).
# En desarrollo se usa el sistema de ficheros local.
STORAGE_DRIVER="filesystem"
STORAGE_PATH="./storage"

# Zona horaria de referencia para todo el cálculo temporal (RN010).
APP_TIMEZONE="Europe/Madrid"

# Validaciones de la regeneración del calendario (RF009).
DUTY_PDF_MAX_SIZE_MB="20"
DUTY_MIN_COVERAGE_RATIO="0.9"
DUTY_MAX_UNRECOGNIZED_RATIO="0.15"

# Solo para `npm run db:seed`: credenciales del primer usuario administrador.
# Cambiar obligatoriamente antes de desplegar en producción.
ADMIN_SEED_EMAIL="admin@mairenadelalcor.org"
ADMIN_SEED_PASSWORD="CambiaEstaClave!2026"

NODE_ENV="development"
